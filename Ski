<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ski-o-matic</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,800&amp;display=swap">
<style>
:root{--ink:#10243a;--card:rgba(255,255,255,.95);--muted:#4a6178;--hot:#ff5a36;--line:rgba(16,36,58,.16);--dis:#e6edf4;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--ink:#eaf3ff;--card:rgba(13,25,41,.95);--muted:#9db3c9;--line:rgba(234,243,255,.2);--dis:#1b2a3d}}
:root[data-theme="dark"]{color-scheme:dark;--ink:#eaf3ff;--card:rgba(13,25,41,.95);--muted:#9db3c9;--line:rgba(234,243,255,.2);--dis:#1b2a3d}
html,body{height:100%;margin:0;overflow:hidden;background:#cfe3f3;color:var(--ink);font-family:"Barlow Condensed","Arial Narrow",system-ui,sans-serif;touch-action:none;user-select:none;-webkit-user-select:none}
#app,#app canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
#hud{position:absolute;inset:0;pointer-events:none;color:#fff;text-shadow:0 1px 8px rgba(5,15,30,.65);display:none}
#hud b{display:block;font-size:42px;line-height:1;font-weight:700}
#hud small{font-size:16px;opacity:.92}
#tl{position:absolute;left:16px;top:12px}
#cb{display:block;color:#ffd23f;font-size:22px;font-weight:700;min-height:22px}
#ms{list-style:none;margin:8px 0 0;padding:0;font-size:17px;font-weight:600}
#ms li{opacity:.85}#ms li.ok{color:#8dffa8;opacity:1}
#tc{position:absolute;left:50%;top:12px;transform:translateX(-50%);text-align:center}
#pg{width:min(34vw,220px);height:5px;border-radius:3px;background:rgba(255,255,255,.35);margin-top:6px;overflow:hidden}
#pgi{display:block;height:100%;width:0;background:#ff5a36}
#tr{position:absolute;right:16px;top:12px;text-align:right}
#mb{position:absolute;right:16px;top:84px;pointer-events:auto;border:1px solid rgba(255,255,255,.5);background:rgba(8,20,40,.35);color:#fff;border-radius:8px;font:600 16px "Barlow Condensed",sans-serif;padding:4px 10px;cursor:pointer}
#pop{position:absolute;left:0;right:0;top:24%;text-align:center;color:#fff;opacity:0;text-shadow:0 2px 14px rgba(5,15,30,.7)}
#pop b{font-size:min(13vw,72px);font-weight:800;font-style:italic}
#pop span{font-size:26px;font-weight:600}
#cd{position:absolute;left:0;right:0;top:30%;text-align:center;color:#fff;font-size:min(30vw,170px);font-weight:800;font-style:italic;text-shadow:0 4px 20px rgba(5,15,30,.6)}
#touch{position:absolute;left:0;right:0;bottom:calc(14px + env(safe-area-inset-bottom,0px));display:none;justify-content:space-between;padding:0 14px;pointer-events:none}
#touch>div{pointer-events:auto;position:relative}
#touch{align-items:flex-end}
#joy{width:132px;height:132px;border-radius:50%;border:2px solid rgba(255,255,255,.6);background:rgba(8,20,40,.32);margin-bottom:6px;touch-action:none}
#knob{position:absolute;left:50%;top:50%;width:56px;height:56px;margin:-28px 0 0 -28px;border-radius:50%;background:rgba(255,255,255,.55);border:2px solid rgba(255,255,255,.9);pointer-events:none}
#acts{width:190px;height:190px}
#touch button.mj,#touch button.a1,#touch button.a2,#touch button.a3{position:absolute}
#touch button.mj{right:0;bottom:0;width:86px;height:86px;font-size:24px;background:rgba(255,90,54,.55)}
#touch button.a1{right:98px;bottom:4px;width:58px;height:58px;font-size:16px}
#touch button.a2{right:82px;bottom:78px;width:58px;height:58px;font-size:18px}
#touch button.a3{right:8px;bottom:98px;width:58px;height:58px;font-size:16px}
#touch button{width:68px;height:68px;border-radius:50%;border:2px solid rgba(255,255,255,.7);background:rgba(8,20,40,.38);color:#fff;font:700 22px "Barlow Condensed",sans-serif;touch-action:none}
#touch button:active{background:rgba(255,90,54,.7)}
@media (pointer:coarse){#touch.on{display:flex}}
@media (max-width:480px){#touch button{width:46px;height:46px;font-size:15px}#touch div{gap:6px}}
#hint{position:absolute;left:0;right:0;bottom:12px;text-align:center;color:#fff;font-size:16px;opacity:.85;text-shadow:0 1px 6px rgba(5,15,30,.7)}
@media (pointer:coarse){#hint{display:none}}
#menu{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(8,20,40,.38);overflow:auto;touch-action:pan-y}
#mw{background:var(--card);border-radius:14px;padding:22px;max-width:820px;width:100%;box-shadow:0 24px 70px rgba(0,0,0,.4);max-height:100%;overflow:auto}
#mw h1{margin:0;font-size:56px;line-height:.95;font-weight:800;font-style:italic}
#mw p{margin:8px 0 14px;color:var(--muted);font:15px/1.35 system-ui,sans-serif}
#cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}
.cd{text-align:left;border:1px solid var(--line);border-radius:10px;padding:12px;background:transparent;color:var(--ink);cursor:pointer;font-family:inherit;display:flex;flex-direction:column;gap:3px}
.cd:hover:not(:disabled){border-color:var(--hot);box-shadow:0 0 0 2px var(--hot) inset}
.cd:disabled{background:var(--dis);opacity:.6;cursor:not-allowed}
.cd:focus-visible,.btn:focus-visible{outline:3px solid var(--ink);outline-offset:2px}
.cd b{font-size:27px;line-height:1}.cd i{font-size:16px;color:var(--muted)}.cd span{font-size:22px;color:#e6a100;letter-spacing:2px}.cd small{font:13px/1.3 system-ui,sans-serif;color:var(--muted)}
.btn{margin:12px 8px 0 0;border:0;border-radius:10px;background:var(--hot);color:#fff;font:700 24px "Barlow Condensed",sans-serif;padding:10px 22px;cursor:pointer}
.btn.alt{background:transparent;color:var(--ink);border:1px solid var(--line)}
.big{font-size:44px;font-weight:700;line-height:1}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>
<div id="app"></div>
<div id="hud">
<div id="tl"><b id="sc">0</b><small>points</small><span id="cb"></span><ul id="ms"></ul></div>
<div id="tc"><b id="tm">0.0</b><div id="pg"><i id="pgi"></i></div></div>
<div id="tr"><b id="sp">0</b><small>km/h</small></div>
<button id="mb">Courses</button>
<div id="pop"><b></b><span></span></div>
<div id="cd"></div>
<div id="hint">Arrows or A/D steer and spin · Up or W tuck, front flip · Down or S brake, back flip · Space jump · G grab · Q turn around</div>
</div>
<div id="touch"><div id="joy"><i id="knob"></i></div><div id="acts"><button data-k="j" class="mj">Jump</button><button data-k="g" class="a1">Grab</button><button data-k="t" class="a2">180</button><button data-k="u" class="a3">Tuck</button></div></div>
<div id="menu"><div id="mw"></div></div>
<script>
const T=THREE,$=id=>document.getElementById(id),G=16,TAU=Math.PI*2;
const mobile=matchMedia('(pointer:coarse)').matches;
const hash=(a,b)=>{const s=Math.sin(a*127.1+b*311.7)*43758.5453;return s-Math.floor(s)};
const sm=(a,b,x)=>{x=Math.min(1,Math.max(0,(x-a)/(b-a)));return x*x*(3-2*x)};
const fmt=t=>Math.floor(t/60)+':'+(t%60<10?'0':'')+(t%60).toFixed(1);

/* ---------- courses ---------- */
const COURSES=[
{id:'meadow',name:'Pine Meadow',lvl:'Easy',blurb:'Wide, gentle groomer with small kickers.',S:.22,w:16,A:16,L:1800,nk:4,kh:[1.6,2.8],gate:150,mog:0,dens:.5,hi:.62,si:.8,sd:[.4,.8,.45],sky:['#3f7fc6','#d5e8f6'],fog:'#d6e7f3',sun:'#fff3dc',
 ms:[['Reach 70 km/h',s=>s.vmax>=70],['Land a 360',s=>s.spin>=360],['Pass 8 gates',s=>s.gates>=8]]},
{id:'ridge',name:'Blue Ridge',lvl:'Intermediate',blurb:'Winding mid-mountain run with real air.',S:.33,w:12,A:26,L:2400,nk:7,kh:[2.2,4],gate:170,mog:0,dens:.6,hi:.58,si:.85,sd:[-.5,.55,.4],sky:['#2f6fb8','#cfe3f5'],fog:'#cfe0ee',sun:'#fff0d0',
 ms:[['Reach 95 km/h',s=>s.vmax>=95],['Land a flip',s=>s.flip>=1],['Pass 6 gates',s=>s.gates>=6]]},
{id:'chute',name:'Black Chute',lvl:'Expert',blurb:'Steep, narrow and mogul-ridden, with rocks and trees close in.',S:.5,w:8,A:32,L:2000,nk:4,kh:[2.5,4],gate:120,mog:.35,dens:.75,hi:.6,si:.5,sd:[.2,.5,.3],sky:['#6c7d90','#c5ced8'],fog:'#bcc6d1',sun:'#e8eef6',
 ms:[['Reach 105 km/h',s=>s.vmax>=105],['Land a 540',s=>s.spin>=540],['Finish with no wipeouts',s=>s.done&&s.crashes===0]]},
{id:'park',name:'Cork Park',lvl:'Park',blurb:'Golden hour and a line of big kickers. Cork it.',S:.3,w:18,A:12,L:2200,nk:12,kh:[3,5.8],gate:0,mog:0,dens:.4,hi:.5,si:1,sd:[.75,.28,.2],sky:['#32508f','#f6b783'],fog:'#efc6a2',sun:'#ffb36b',
 ms:[['Land a Cork 720',s=>s.cork>=720],['Reach a ×4 combo',s=>s.combo>=4],['Score 6000 points',s=>s.score>=6000]]},
{id:'slalom',name:'Alpenglow Slalom',lvl:'Intermediate',blurb:'Gate after gate at sunrise. Stay sharp.',S:.3,w:14,A:30,L:2000,nk:2,kh:[2,3],gate:55,mog:0,dens:.55,hi:.5,si:.95,sd:[-.7,.25,.3],sky:['#4a5a9a','#ffc7a0'],fog:'#f5cdb4',sun:'#ffc890',
 ms:[['Pass 20 gates',s=>s.gates>=20],['Reach 100 km/h',s=>s.vmax>=100],['Finish with no wipeouts',s=>s.done&&s.crashes===0]]},
{id:'bowl',name:'Powder Bowl',lvl:'Intermediate',blurb:'Wide-open alpine bowl with big air and hardly any trees.',S:.38,w:30,A:40,L:2400,nk:8,kh:[3,5],gate:0,mog:.1,dens:.12,hi:.62,si:.9,sd:[.3,.85,.2],sky:['#1f66c4','#bfe0f8'],fog:'#c6e0f2',sun:'#fffaf0',
 ms:[['Land a Cork 540',s=>s.cork>=540],['Reach 110 km/h',s=>s.vmax>=110],['Score 5000 points',s=>s.score>=5000]]},
{id:'storm',name:'Whiteout',lvl:'Expert',blurb:'Blizzard, thick fog, and trees that appear out of nowhere.',S:.42,w:11,A:28,L:2200,nk:5,kh:[2.5,4],gate:130,mog:.2,dens:.7,hi:.7,si:.35,sd:[.1,.6,.2],sky:['#8e9aa6','#c9d0d6'],fog:'#c3cad1',sun:'#dfe6ee',fd:70,
 ms:[['Reach 100 km/h',s=>s.vmax>=100],['Pass 10 gates',s=>s.gates>=10],['Land a flip',s=>s.flip>=1]]},
{id:'night',name:'Night Run',lvl:'Hard',blurb:'Moonlit powder under the stars. Hard to see, easy to love.',S:.36,w:12,A:30,L:2300,nk:7,kh:[2.5,4.5],gate:150,mog:.15,dens:.6,hi:.5,si:.55,sd:[-.3,.6,.4],sky:['#030814','#1c2b55'],fog:'#18244a',sun:'#9db8ff',fd:100,dim:.3,
 ms:[['Land a 720',s=>s.spin>=720],['Reach 100 km/h',s=>s.vmax>=100],['Finish with no wipeouts',s=>s.done&&s.crashes===0]]},
{id:'spine',name:'Dragon’s Spine',lvl:'Extreme',blurb:'A razor-thin ridgeline. One mistake and the rocks win.',S:.6,w:6,A:38,L:2400,nk:5,kh:[3,5],gate:0,mog:.5,dens:.85,hi:.55,si:.6,sd:[.4,.4,.5],sky:['#5b2a3a','#f0a77a'],fog:'#d9a98f',sun:'#ffd1a0',
 ms:[['Reach 115 km/h',s=>s.vmax>=115],['Land a Cork 720',s=>s.cork>=720],['Finish with no wipeouts',s=>s.done&&s.crashes===0]]}
];
let CR=COURSES[0],SV={st:{},best:{}};
try{SV=Object.assign(SV,JSON.parse(localStorage.getItem('cr3d')))}catch(e){}
const save=()=>{try{localStorage.setItem('cr3d',JSON.stringify(SV))}catch(e){}};
const stars=()=>Object.values(SV.st).reduce((a,b)=>a+b.filter(Boolean).length,0);

/* ---------- terrain ---------- */
const C=d=>CR.A*(Math.sin(d*.0042)+.5*Math.sin(d*.0113+1.7));
function prep(c){CR=c;c.K=[];for(let i=0;i<c.nk;i++){const d=300+(c.L-600)*(i+.5)/c.nk+(hash(i,c.S*100)-.5)*50,h=c.kh[0]+hash(i,3)*(c.kh[1]-c.kh[0]);c.K.push({d,L:9+h*1.5,h,hw:Math.min(7,c.w*.38),o:(hash(i,9)-.5)*c.w*.3})}
 c.GT=[];if(c.gate)for(let d=180,i=0;d<c.L-100;d+=c.gate,i++)c.GT.push({d,x:C(d)+(i%2?1:-1)*c.w*.3,done:0})}
function H(x,z){const d=-z,ad=Math.abs(x-C(d)),w=CR.w;
 let h=-CR.S*(d-40*Math.cos(d*.006))+2.2*Math.sin(d*.013)+1.2*Math.sin(d*.041);
 const off=sm(w*.7,w*1.5,ad);
 h+=sm(w,w+30,ad)*(ad-w)*.22+off*(1.8*Math.sin(x*.045+d*.02)+1.1*Math.sin(x*.11-d*.07)+.5*Math.sin(x*.3+d*.23))+.1*Math.sin(x*.9+d*.6);
 if(CR.mog)h+=CR.mog*Math.sin(x*.55+1)*Math.sin(d*.5)*(1-off);
 for(const k of CR.K){const t=d-(k.d-k.L);if(t>=0&&t<=k.L){const e=1-sm(k.hw,k.hw+2,Math.abs(x-C(d)-k.o)),u=t/k.L;h+=k.h*u*u*e}}
 return h}
function N(x,z,o){const e=.6,dx=(H(x+e,z)-H(x-e,z))/(2*e),dz=(H(x,z+e)-H(x,z-e))/(2*e),l=Math.hypot(dx,1,dz);o.set(-dx/l,1/l,-dz/l)}

/* ---------- renderer / scene ---------- */
const R=new T.WebGLRenderer({antialias:!mobile});R.setPixelRatio(Math.min(devicePixelRatio||1,mobile?1.5:2));$('app').appendChild(R.domElement);
const scene=new T.Scene(),cm=new T.PerspectiveCamera(65,1,.3,4000);scene.fog=new T.Fog(0xd6e7f3,30,mobile?115:150);
function resize(){R.setSize(innerWidth,innerHeight);cm.aspect=innerWidth/innerHeight;cm.updateProjectionMatrix()}addEventListener('resize',resize);resize();
const hemi=new T.HemisphereLight(0xffffff,0x8ea3ba,.6),sun=new T.DirectionalLight(0xffffff,.8);scene.add(hemi,sun);
const skyMat=new T.ShaderMaterial({side:T.BackSide,depthWrite:false,fog:false,uniforms:{top:{value:new T.Color()},hor:{value:new T.Color()}},
 vertexShader:'varying vec3 v;void main(){v=normalize(position);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}',
 fragmentShader:'uniform vec3 top,hor;varying vec3 v;void main(){float h=clamp(v.y,0.,1.);gl_FragColor=vec4(mix(hor,top,pow(h,.55)),1.);}'});
const sky=new T.Mesh(new T.SphereGeometry(2000,24,12),skyMat);sky.frustumCulled=false;sky.renderOrder=-10;scene.add(sky);
function glow(){const c=document.createElement('canvas');c.width=c.height=128;const x=c.getContext('2d'),g=x.createRadialGradient(64,64,0,64,64,64);g.addColorStop(0,'rgba(255,255,255,1)');g.addColorStop(.25,'rgba(255,255,255,.55)');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,128,128);return new T.CanvasTexture(c)}
const gtex=glow(),sunSpr=new T.Sprite(new T.SpriteMaterial({map:gtex,blending:T.AdditiveBlending,depthWrite:false,fog:false,transparent:true}));sunSpr.scale.set(520,520,1);sunSpr.renderOrder=-9;scene.add(sunSpr);
const clouds=new T.Group();for(let i=0;i<12;i++){const s=new T.Sprite(new T.SpriteMaterial({map:gtex,transparent:true,opacity:.5,depthWrite:false,fog:false,color:0xffffff}));const a=i/12*TAU+hash(i,1);s.position.set(Math.cos(a)*(900+hash(i,2)*500),130+hash(i,3)*170,Math.sin(a)*(900+hash(i,2)*500));s.scale.set(480+hash(i,4)*400,110+hash(i,5)*60,1);clouds.add(s)}scene.add(clouds);
function ring(Rr,hA,seed,jag){const seg=128,rows=5,p=[],c=[],ix=[];
 for(let i=0;i<=seg;i++){const a=i/seg*TAU,nz=Math.abs(Math.sin(a*3+seed)*.5+Math.sin(a*7+seed*2)*.3+Math.sin(a*17+seed*3)*.2*jag),pk=hA*(.3+.7*nz);
  for(let j=0;j<=rows;j++){const f=j/rows;p.push(Math.cos(a)*Rr,-120+f*pk,Math.sin(a)*Rr);const v=f<.2?1-.38*f/.2:.62+.38*sm(.5,.78,f);c.push(v,v,v)}}
 for(let i=0;i<seg;i++)for(let j=0;j<rows;j++){const a=i*(rows+1)+j,b=a+rows+1;ix.push(a,b,a+1,b,b+1,a+1)}
 const g=new T.BufferGeometry();g.setAttribute('position',new T.Float32BufferAttribute(p,3));g.setAttribute('color',new T.Float32BufferAttribute(c,3));g.setIndex(ix);
 const m=new T.Mesh(g,new T.MeshBasicMaterial({vertexColors:true,fog:false,side:T.DoubleSide}));m.frustumCulled=false;scene.add(m);return m}
const farM=ring(1500,620,1.3,1),nearM=ring(1050,400,4.1,1.4);

/* terrain mesh */
const NG=mobile?100:140,CELL=1.5,VN=(NG+1)*(NG+1);
const tg=new T.BufferGeometry();tg.setAttribute('position',new T.BufferAttribute(new Float32Array(VN*3),3));tg.setAttribute('color',new T.BufferAttribute(new Float32Array(VN*3),3));
{const ix=new Uint32Array(NG*NG*6);let k=0;for(let j=0;j<NG;j++)for(let i=0;i<NG;i++){const a=j*(NG+1)+i,b=a+NG+1;ix[k++]=a;ix[k++]=b;ix[k++]=a+1;ix[k++]=b;ix[k++]=b+1;ix[k++]=a+1}tg.setIndex(new T.BufferAttribute(ix,1))}
const terrain=new T.Mesh(tg,new T.MeshLambertMaterial({vertexColors:true}));terrain.frustumCulled=false;scene.add(terrain);
let lcx=1e9,lcz=1e9;
function rebuild(cx,cz){const p=tg.attributes.position.array;let k=0;
 for(let j=0;j<=NG;j++){const z=cz+(j-NG/2)*CELL;for(let i=0;i<=NG;i++){const x=cx+(i-NG/2)*CELL;p[k++]=x;p[k++]=H(x,z);p[k++]=z}}
 tg.attributes.position.needsUpdate=true;tg.computeVertexNormals();
 const nr=tg.attributes.normal.array,c=tg.attributes.color.array;k=0;
 for(let v=0;v<VN;v++){const x=p[v*3],z=p[v*3+2],ny=nr[v*3+1],ad=Math.abs(x-C(-z)),rock=1-sm(.58,.8,ny),gr=1-sm(CR.w*.85,CR.w*1.1,ad),n=.5+.5*Math.sin(x*.7)*Math.sin(z*.6+x*.2);
  const br=gr?.97+.03*Math.sin(x*2.6):.84+.12*n,rk=(.8+.3*n)*.4;
  c[k++]=.93*br*(1-rock)+rk*rock;c[k++]=.955*br*(1-rock)+rk*.97*rock;c[k++]=1*br*(1-rock)+rk*1.02*rock}
 tg.attributes.color.needsUpdate=true}

/* trees and rocks */
function merge(parts){const p=[],n=[],c=[],ix=[];let o=0;
 for(const[g,y,c0,c1]of parts){g.translate(0,y,0);const P=g.attributes.position,Q=g.attributes.normal;g.computeBoundingBox();const b=g.boundingBox;
  for(let i=0;i<P.count;i++){p.push(P.getX(i),P.getY(i),P.getZ(i));n.push(Q.getX(i),Q.getY(i),Q.getZ(i));const t=Math.pow((P.getY(i)-b.min.y)/(b.max.y-b.min.y),1.4);c.push(c0[0]+(c1[0]-c0[0])*t,c0[1]+(c1[1]-c0[1])*t,c0[2]+(c1[2]-c0[2])*t)}
  for(const i of g.index.array)ix.push(i+o);o+=P.count}
 const g=new T.BufferGeometry();g.setAttribute('position',new T.Float32BufferAttribute(p,3));g.setAttribute('normal',new T.Float32BufferAttribute(n,3));g.setAttribute('color',new T.Float32BufferAttribute(c,3));g.setIndex(ix);return g}
const gr0=[.08,.22,.16],gr1=[.55,.65,.6],br0=[.22,.15,.1];
const treeG=merge([[new T.CylinderGeometry(.2,.26,1.4,6),.7,br0,br0],[new T.ConeGeometry(2.1,3.2,8),2.3,gr0,gr1],[new T.ConeGeometry(1.6,2.8,8),3.8,gr0,gr1],[new T.ConeGeometry(1.1,2.4,8),5.1,gr0,[.9,.93,.95]]]);
const MAXT=1100,MAXR=260,trees=new T.InstancedMesh(treeG,new T.MeshLambertMaterial({vertexColors:true}),MAXT);
const rg=new T.IcosahedronGeometry(1,1);{const p=rg.attributes.position;for(let i=0;i<p.count;i++){const f=.8+hash(p.getX(i)*9,p.getZ(i)*7)*.4;p.setXYZ(i,p.getX(i)*f,p.getY(i)*f,p.getZ(i)*f)}rg.computeVertexNormals()}
const rocks=new T.InstancedMesh(rg,new T.MeshLambertMaterial({color:0x6b6e75,flatShading:true}),MAXR);
