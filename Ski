 return '<button class="cd" data-i="'+i+'"'+(lock?' disabled':'')+'><b>'+c.name+'</b><i>'+c.lvl+', '+Math.round(Math.atan(c.S)*57.3)+'° average slope</i><span>'+'★'.repeat(s)+'☆'.repeat(3-s)+'</span><small>'+(lock?'Needs '+c.need+' stars':b?'Best '+fmt(b.t)+', '+b.s+' points':c.blurb)+'</small></button>'}).join('')+'</div><p style="margin-top:14px">Left and right steer on snow and spin in the air. Up tucks for speed, or front flips. Down brakes, or back flips. Space jumps, and you can spin and flip off your own jumps too. Hold G or Shift in the air to grab. On a touch screen, use the on-screen buttons.</p><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><input id="ac" type="text" placeholder="Admin code" autocomplete="off" style="font:16px system-ui,sans-serif;padding:9px 10px;border-radius:8px;border:1px solid var(--line);background:transparent;color:var(--ink);width:150px"><button class="btn alt" data-a="code" style="margin:0;padding:7px 16px">Unlock all</button><span id="am" style="font:14px system-ui,sans-serif;color:var(--muted)">'+(SV.admin?'All maps unlocked':'')+'</span></div><p style="text-align:center;margin:18px 0 0;font-weight:600">Made by Izzy</p>'}
COURSES.forEach((c,i)=>c.need=[0,2,5,8,11,14,17,20,23][i]);
$('mw').addEventListener('click',e=>{const b=e.target.closest('[data-i]');if(b&&!b.disabled)startRun(+b.dataset.i);const a=e.target.closest('[data-a]');if(a){if(a.dataset.a==='code'){const v=$('ac').value.trim().toUpperCase();if(v==='CORKADMIN'){SV.admin=true;save();showMenu()}else $('am').textContent='Wrong code'}else a.dataset.a==='again'?startRun(COURSES.indexOf(CR)):toMenu()}});
$('mb').addEventListener('click',toMenu);

/* input */
const km={ArrowLeft:'l',KeyA:'l',ArrowRight:'r',KeyD:'r',ArrowUp:'u',KeyW:'u',ArrowDown:'d',KeyS:'d',Space:'j',KeyG:'g',ShiftLeft:'g',KeyQ:'t',KeyE:'t'};
addEventListener('keydown',e=>{if(e.target.tagName==='INPUT'){if(e.code==='Enter'){const b=document.querySelector('[data-a="code"]');b&&b.click()}return}if(e.code==='Escape'&&mode!=='menu')toMenu();const k=km[e.code];if(k){inp[k]=1;e.preventDefault()}});
addEventListener('keyup',e=>{const k=km[e.code];if(k)inp[k]=0});
addEventListener('blur',()=>{for(const k in inp)inp[k]=0});
document.querySelectorAll('#touch button').forEach(b=>{const k=b.dataset.k;b.addEventListener('pointerdown',e=>{inp[k]=1;e.preventDefault()});['pointerup','pointerleave','pointercancel'].forEach(t=>b.addEventListener(t,()=>inp[k]=0))});
addEventListener('contextmenu',e=>e.preventDefault());
{const joy=$('joy'),kn=$('knob');let pid=null;
const mv=e=>{const r=joy.getBoundingClientRect(),R0=r.width/2;let dx=e.clientX-r.left-R0,dy=e.clientY-r.top-R0;const l=Math.hypot(dx,dy);if(l>R0){dx*=R0/l;dy*=R0/l}
 kn.style.transform='translate('+dx+'px,'+dy+'px)';inp.l=dx<-R0*.3?1:0;inp.r=dx>R0*.3?1:0;inp.u=dy<-R0*.5?1:0;inp.d=dy>R0*.5?1:0};
const end=()=>{pid=null;kn.style.transform='';inp.l=inp.r=inp.u=inp.d=0};
joy.addEventListener('pointerdown',e=>{pid=e.pointerId;joy.setPointerCapture(pid);mv(e);e.preventDefault()});
joy.addEventListener('pointermove',e=>{if(e.pointerId===pid)mv(e)});
['pointerup','pointercancel'].forEach(t=>joy.addEventListener(t,end))}

/* camera and render */
let lastT=performance.now(),idle=0;
function render(dt,now){
 if(mode==='menu'){idle+=dt;const a=idle*.08;hd.set(Math.sin(a)*.6,0,-1).normalize();if(!air&&pos.y===0){pos.set(C(15),0,-15);pos.y=H(pos.x,pos.z)}}
 const fwd=air?v1.set(V.x,0,V.z):v1.set(hd.x,0,hd.z);if(fwd.lengthSq()<1e-4)fwd.set(0,0,-1);fwd.normalize();
 cd.lerp(fwd,snapCam?1:1-Math.exp(-3*dt)).normalize();
 const sp=V.length(),camDist=mode==='menu'?11:7.2;
 ctg.set(pos.x-cd.x*camDist,pos.y+(mode==='menu'?4:3.1),pos.z-cd.z*camDist);ctg.y=Math.max(ctg.y,H(ctg.x,ctg.z)+1.4);
 if(snapCam){cm.position.copy(ctg);snapCam=false}else cm.position.lerp(ctg,1-Math.exp(-9*dt));
 if(!air&&sp>20&&mode==='play')cm.position.y+=(Math.random()-.5)*.025*sp/30;
 cm.lookAt(pos.x+cd.x*6,pos.y+1.2,pos.z+cd.z*6);
 const fov=62+Math.min(16,sp*.45);if(Math.abs(fov-cm.fov)>.15){cm.fov+=(fov-cm.fov)*.1;cm.updateProjectionMatrix()}
 // terrain + trees follow
 const sn=CELL*2,cx=Math.round((cm.position.x+cd.x*60)/sn)*sn,cz=Math.round((cm.position.z+cd.z*60)/sn)*sn;
 if(cx!==lcx||cz!==lcz){lcx=cx;lcz=cz;rebuild(cx,cz)}
 if(Math.floor(pos.x/8)!==lti||Math.floor(pos.z/8)!==ltj)updTrees();
 // skier pose
 if(crashT>0){bq(nn,hd,qa);qa.multiply(qb.setFromAxisAngle(xaxis,tumble))}
 else if(air){bq(Y,hh,qa);qa.multiply(qb.setFromAxisAngle(xaxis,ap+phi)).multiply(qb.setFromAxisAngle(gaxis,psi+sa))}
 else{const t=swt*Math.PI;sa+=(t+TAU*Math.round((sa-t)/TAU)-sa)*Math.min(1,dt*12);bq(nn,hd,qa);qa.multiply(qb.setFromAxisAngle(zaxis,roll)).multiply(qb.setFromAxisAngle(gaxis,sa))}
 skier.quaternion.slerp(qa,air?1:1-Math.exp(-20*dt));skier.position.copy(pos);
 const tuck=!air&&crashT<=0&&inp.u&&mode==='play'?1:0,body=skier.userData.body;
 body.rotation.x+=((tuck?.6:air?grabT*.4:0)-body.rotation.x)*Math.min(1,dt*10);body.scale.y=1-.22*(tuck||grabT*.6);
 const gh=H(pos.x,pos.z);blob.position.set(pos.x,gh+.06,pos.z);N(pos.x,pos.z,nn2);bq(nn2,zaxis.clone().set(0,0,-1),qb);blob.quaternion.copy(qb).multiply(qa.setFromAxisAngle(xaxis,-Math.PI/2));
 const hh2=Math.max(0,pos.y-gh);blob.scale.setScalar(Math.max(.4,1-hh2*.06));blob.material.opacity=Math.max(.05,.24-hh2*.02);
 // ghost
 if(ghostData&&(mode==='play'||mode==='count')){const f=Math.max(0,time)/.1,i=Math.floor(f);if(i+1<ghostData.length){const a=ghostData[i],b=ghostData[i+1],t=f-i;ghostM.visible=true;ghostM.position.set(a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t,a[2]+(b[2]-a[2])*t);ghostM.rotation.y=a[3]}else ghostM.visible=false}else ghostM.visible=false;
 // particles
 for(let i=0;i<NP;i++){if(pl[i]>0){pl[i]-=dt;pv[i*3+1]-=9*dt;pp[i*3]+=pv[i*3]*dt;pp[i*3+1]+=pv[i*3+1]*dt;pp[i*3+2]+=pv[i*3+2]*dt}else pp[i*3+1]=-1e4}pg.attributes.position.needsUpdate=true;
 // backdrop follows camera
 sky.position.copy(cm.position);clouds.position.copy(cm.position);clouds.rotation.y+=dt*.002;
 farM.position.set(cm.position.x,cm.position.y,cm.position.z);nearM.position.copy(farM.position);
 v2.set(...CR.sd).normalize();sunSpr.position.copy(cm.position).addScaledVector(v2,1800);
 R.render(scene,cm);
 if(mode==='play'||mode==='count'){$('sc').textContent=Math.round(score);$('cb').textContent=combo>1?'×'+combo+' combo':'';$('tm').textContent=fmt(time);$('sp').textContent=Math.round(sp*3.6);$('pgi').style.width=Math.min(100,-pos.z/CR.L*100)+'%'}}
function frame(now){const dt=Math.min(.05,(now-lastT)/1000);lastT=now;if(mode==='play'||mode==='count')update(dt);render(dt,now);requestAnimationFrame(frame)}
prep(COURSES[0]);env();props();pos.set(C(15),0,-15);pos.y=H(pos.x,pos.z);showMenu();requestAnimationFrame(frame);
